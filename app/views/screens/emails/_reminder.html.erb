  <div class="mt-4 rounded border border-tool-border bg-tool-surface p-4 text-sm space-y-3">
    <p>Hi <%= scenario.seed[:recipient_name] %>,</p>
    <p>You still have a document waiting. Your invitation number is:</p>
    <p class="text-center text-lg font-mono font-semibold tracking-wide py-2 rounded bg-tool-surface-raised border border-tool-border">
      <%= scenario.seed[:invitation_number] %>
