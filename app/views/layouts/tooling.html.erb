<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Screen catalog — Certified Receipt (review)" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# Deliberately un-branded "paper" chrome (SPEC §1.1): tool-* tokens only, never product-* %>
  <body class="bg-tool-surface text-tool-ink font-tool-mono antialiased">
    <%= yield %>
  </body>
</html>
